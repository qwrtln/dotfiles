#!/bin/bash
EXT="gsconnect@andyholmes.github.io"

if [[ "$1" != "-y" ]]; then
    zenity --question --text="Hibernate?" || exit 0
fi

gnome-extensions disable "$EXT"
loginctl lock-session
sleep 0.5
(
    if systemctl hibernate; then
        sleep 60
    fi
    gnome-extensions enable "$EXT"
) &
disown
